{
  "name": "Goal",
  "type": "object",
  "properties": {
    "cycle_id": {
      "type": "string",
      "title": "Cycle"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "success_metric": {
      "type": "string",
      "title": "Success metric"
    },
    "order": {
      "type": "number",
      "default": 0,
      "title": "Order"
    },
    "nudge_enabled": {
      "type": "boolean",
      "default": false,
      "title": "Daily nudge enabled"
    }
  },
  "required": [
    "cycle_id",
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}