# Public Base44 app ID (from https://app.base44.com/apps/<app-id>/editor).
VITE_BASE44_APP_ID=

# Published Base44 app origin, NOT the localhost or Vercel frontend URL.
VITE_BASE44_APP_BASE_URL=

# Optional: pin a deployed Base44 functions version; leave blank for default.
VITE_BASE44_FUNCTIONS_VERSION=
